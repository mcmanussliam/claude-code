{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023"
    ],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment"
  },
  "include": [
    "types",
    "*/types/**/*.d.ts",
    "*/hooks",
    "*/tests"
  ],
  "exclude": [
    "temporary-rule-poc/hooks",
    "temporary-rule-poc/tests",
    "temporary-rule-example/hooks"
  ]
}
